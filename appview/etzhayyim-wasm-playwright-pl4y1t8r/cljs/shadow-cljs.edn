;; etzhayyim-wasm-playwright-pl4y1t8r appview — single-page app, single build/module.
{:deps   {:aliases [:cljs :test]}
 :builds {:app  {:target :browser
                 :output-dir "public/js"
                 :asset-path "js"
                 :modules {:app {:init-fn playwright.app/main}}}
          :test {:target :node-test
                 :output-to "out/tests.js"
                 :ns-regexp "-test$"}}}
