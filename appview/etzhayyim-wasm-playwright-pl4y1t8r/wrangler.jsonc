{
  "name": "kotodama-pl4y1t8r",
  // "main" dropped: it pointed at the SvelteKit Cloudflare adapter's build
  // output (svelte/.svelte-kit/cloudflare/_worker.js), which no longer
  // exists after the Svelte → ClojureScript frontend migration (see
  // ../cljs/). "../src/app.ts" (the documented dispatcher Worker) was
  // considered as a replacement but does not call `env.ASSETS.fetch()`, so
  // pointing `main` at it would put a worker in front of the static assets
  // with nothing serving them. Frontend is served as plain static assets
  // instead (see "assets" below). UNVERIFIED: no `wrangler deploy`/`dev` was
  // run as part of this migration.
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"browser-goto\",\"browser-fill\",\"browser-click\",\"browser-scrape\",\"browser-snapshot\",\"browser-screenshot\",\"session-management\",\"value-ref-resolution\"]",
    "APP_DEPLOY_AT": "2026-04-19T10:00:00Z",
    "APP_DESCRIPTION": "Browser automation primitives XRPC — goto/fill/click/scrape/snapshot over local daemon OR cf-browser",
    "APP_DISPLAY_NAME": "Playwright",
    "APP_EMBED_URL": "https://pl4y1t8r.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "pl4y1t8r",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\",\"etzhayyim:vault/vault@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "pl4y1t8r.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "playwright.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
